{
  "name": "rsyncbud",
  "version": "1.0.0",
  "description": "A context-aware graphical interface for rsync, integrated as a macOS Finder Quick Action.",
  "main": "src/main/index.js",
  "scripts": {
    "prestart": "npm run build:css",
    "start": "electron .",
    "build:css": "tailwindcss -i ./src/renderer/styles.css -o ./src/renderer/dist/output.css --minify",
    "watch:css": "tailwindcss -i ./src/renderer/styles.css -o ./src/renderer/dist/output.css --watch"
  },
  "keywords": [
    "rsync",
    "electron",
    "macos",
    "finder"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "electron": "^41.0.3",
    "tailwindcss": "^4.3.3"
  }
}
